---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/theme.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { oppositeLocale, toOpenGraphLocale, translate } from '../i18n/utils';
import { DEFAULT_LOCALE } from '../i18n/ui';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  translationPath?: string;
}

const { locale, title, description, translationPath } = Astro.props;
const t = translate(locale);
const homeUrl: string = getRelativeLocaleUrl(locale, '');
const writingUrl: string = getRelativeLocaleUrl(locale, 'blog');
const feedUrl: string = `${getRelativeLocaleUrl(locale, '')}rss.xml`;
const otherLocale: Locale = oppositeLocale(locale);
const selfUrl: URL = new URL(Astro.url.pathname, Astro.site);
const translationUrl: URL | null =
  translationPath === undefined
    ? null
    : new URL(getRelativeLocaleUrl(otherLocale, translationPath), Astro.site);
const defaultLocaleUrl: URL | null = locale === DEFAULT_LOCALE ? selfUrl : translationUrl;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0810" />
    <link rel="canonical" href={selfUrl} />
    <link rel="alternate" hreflang={locale} href={selfUrl} />
    {translationUrl && <link rel="alternate" hreflang={otherLocale} href={translationUrl} />}
    {defaultLocaleUrl && <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={selfUrl} />
    <meta property="og:locale" content={toOpenGraphLocale(locale)} />
    {translationUrl && (
      <meta property="og:locale:alternate" content={toOpenGraphLocale(otherLocale)} />
    )}
    <link rel="alternate" type="application/rss+xml" title={t.siteTitle} href={feedUrl} />
  </head>
  <body>
    <div class="top-bar">
      <div class="shell">
        <p class="tagline"><span aria-hidden="true">&#9670;</span> {t.tagline}</p>
        <a href={feedUrl}>{t.feedLabel} &#8599;</a>
      </div>
    </div>

    <header class="site-header shell">
      <a class="site-name" href={homeUrl}>{t.siteTitle}</a>
      <nav>
        <a href={writingUrl}>{t.navWriting}</a>
        <LanguageSwitcher locale={locale} translationPath={translationPath} />
      </nav>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p>
          &copy; {new Date().getFullYear()} {t.siteTitle}
        </p>
        <nav aria-label={t.elsewhere}>
          <a href="https://github.com/ervinaldodiaz">GitHub</a>
          <a href="https://mx.linkedin.com/in/ervin-aldo-d%C3%ADaz-jim%C3%A9nez-2b4202270">
            LinkedIn
          </a>
          <a href={feedUrl}>{t.feedLabel}</a>
        </nav>
      </div>
    </footer>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: var(--body-size);
        line-height: var(--body-leading);
        -webkit-font-smoothing: antialiased;
      }

      .shell {
        max-width: var(--poster);
        margin: 0 auto;
        padding-inline: 1.5rem;
      }

      main {
        padding-block: 4rem 7rem;
      }

      a {
        color: var(--accent);
        text-underline-offset: 0.25em;
      }

      :focus-visible {
        outline: 2px solid var(--signal);
        outline-offset: 3px;
      }

      .top-bar {
        background: var(--ink);
        border-bottom: 1px solid var(--rule);
        font-family: var(--font-mono);
        font-size: var(--meta-size);
        letter-spacing: var(--meta-tracking);
        text-transform: var(--meta-transform);
      }

      .top-bar .shell {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        align-items: center;
        justify-content: space-between;
        padding-block: 0.75rem;
      }

      .top-bar p {
        margin: 0;
      }

      .top-bar span {
        color: var(--signal);
        margin-right: 0.6em;
      }

      .top-bar a {
        color: var(--fg-muted);
        text-decoration: none;
      }

      .top-bar a:hover {
        color: var(--signal);
      }

      .site-header {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.5rem;
        align-items: center;
        justify-content: space-between;
        padding-block: 2rem;
      }

      .site-name {
        color: var(--fg);
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.0625rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .site-header nav {
        display: flex;
        gap: 1.75rem;
        align-items: center;
        font-family: var(--font-mono);
        font-size: var(--meta-size);
        letter-spacing: var(--meta-tracking);
        text-transform: var(--meta-transform);
      }

      .site-header nav > a {
        color: var(--fg-muted);
        text-decoration: none;
      }

      .site-header nav > a:hover {
        color: var(--fg);
      }

      .site-footer {
        border-top: 1px solid var(--rule);
        color: var(--fg-muted);
        font-family: var(--font-mono);
        font-size: var(--meta-size);
        letter-spacing: var(--meta-tracking);
        text-transform: var(--meta-transform);
      }

      .site-footer .shell {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        align-items: center;
        justify-content: space-between;
        padding-block: 2.5rem 3rem;
      }

      .site-footer p {
        margin: 0;
      }

      .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1.75rem;
      }

      h1,
      h2,
      h3 {
        line-height: 1.05;
        letter-spacing: var(--h1-tracking);
        font-weight: var(--h1-weight);
        margin: 2.75rem 0 1rem;
      }

      h1 {
        font-size: var(--h1-size);
        margin-top: 0;
      }

      p {
        margin: 0 0 1.5rem;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.875em;
        background: var(--bg-lift);
        border: 1px solid var(--rule);
        padding: 0.15em 0.4em;
        border-radius: 3px;
      }

      pre {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        line-height: 1.7;
        padding: 1.25rem 1.5rem;
        background: var(--bg-lift);
        border: 1px solid var(--rule);
        border-radius: 4px;
        overflow-x: auto;
      }

      pre code {
        background: none;
        border: none;
        padding: 0;
        font-size: inherit;
      }

      blockquote {
        margin: 2rem 0;
        padding-left: 1.5rem;
        border-left: 3px solid var(--accent);
        color: var(--fg-muted);
      }
    </style>
  </body>
</html>
