---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/theme.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { oppositeLocale, translate } from '../i18n/utils';
import { DEFAULT_LOCALE } from '../i18n/ui';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  translationPath?: string;
}

const { locale, title, description, translationPath } = Astro.props;
const t = translate(locale);
const homeUrl: string = getRelativeLocaleUrl(locale, '');
const writingUrl: string = getRelativeLocaleUrl(locale, 'blog');
const feedUrl: string = `${getRelativeLocaleUrl(locale, '')}rss.xml`;
const otherLocale: Locale = oppositeLocale(locale);
const selfUrl: URL = new URL(Astro.url.pathname, Astro.site);
const translationUrl: URL | null =
  translationPath === undefined
    ? null
    : new URL(getRelativeLocaleUrl(otherLocale, translationPath), Astro.site);
const defaultLocaleUrl: URL | null = locale === DEFAULT_LOCALE ? selfUrl : translationUrl;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={selfUrl} />
    <link rel="alternate" hreflang={locale} href={selfUrl} />
    {translationUrl && <link rel="alternate" hreflang={otherLocale} href={translationUrl} />}
    {defaultLocaleUrl && <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title={t.siteTitle} href={feedUrl} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={homeUrl}>{t.siteTitle}</a>
      <nav>
        <a href={writingUrl}>{t.navWriting}</a>
        <LanguageSwitcher locale={locale} translationPath={translationPath} />
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        &copy; {new Date().getFullYear()} {t.siteTitle} &middot; <a href={feedUrl}>{t.feedLabel}</a>
      </p>
    </footer>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0 1.5rem;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: var(--body-size);
        line-height: var(--body-leading);
        -webkit-font-smoothing: antialiased;
      }

      main {
        max-width: var(--measure);
        margin: 0 auto;
        padding: 3.5rem 0;
      }

      a {
        color: var(--accent);
        text-underline-offset: 0.2em;
      }

      .site-header {
        max-width: var(--measure);
        margin: 0 auto;
        padding: 2rem 0 1.25rem;
        border-bottom: 1px solid var(--rule);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        align-items: baseline;
        justify-content: space-between;
        font-family: var(--font-ui);
        font-size: 0.875rem;
      }

      .site-name {
        color: var(--fg);
        text-decoration: none;
      }

      .site-header nav {
        display: flex;
        gap: 1.5rem;
        align-items: baseline;
      }

      .site-footer {
        max-width: var(--measure);
        margin: 0 auto;
        padding: 2rem 0 3rem;
        border-top: 1px solid var(--rule);
        color: var(--fg-muted);
        font-family: var(--font-ui);
        font-size: 0.8125rem;
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
        letter-spacing: var(--h1-tracking);
        font-weight: var(--h1-weight);
        margin: 2.75rem 0 0.75rem;
      }

      h1 {
        font-size: var(--h1-size);
        margin-top: 0;
      }

      h2 {
        font-size: 1.375rem;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.875em;
        background: var(--rule);
        padding: 0.15em 0.35em;
        border-radius: 3px;
      }

      pre {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        line-height: 1.6;
        padding: 1rem 1.25rem;
        border-radius: 6px;
        overflow-x: auto;
      }

      pre code {
        background: none;
        padding: 0;
        font-size: inherit;
      }

      blockquote {
        margin: 1.5rem 0;
        padding-left: 1.25rem;
        border-left: 3px solid var(--rule);
        color: var(--fg-muted);
        font-style: italic;
      }
    </style>
  </body>
</html>
