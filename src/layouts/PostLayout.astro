---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from './BaseLayout.astro';
import { formatPostDate, translate, translationPathOf } from '../i18n/utils';
import type { BlogPost } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const locale: Locale = post.data.lang;
const t = translate(locale);
---

<BaseLayout
  locale={locale}
  title={`${post.data.title} — ${t.siteTitle}`}
  description={post.data.description}
  translationPath={translationPathOf(post)}
>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.date.toISOString()}>
        {formatPostDate(post.data.date, locale)}
      </time>
      {post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}
    </p>

    <slot />

    {
      post.data.updated && (
        <p class="updated">
          {t.updatedOn} {formatPostDate(post.data.updated, locale)}
        </p>
      )
    }

    <p class="back">
      <a href={getRelativeLocaleUrl(locale, 'blog')}>← {t.backToWriting}</a>
    </p>
  </article>
</BaseLayout>

<style>
  article > h1 {
    padding-top: 0.08em;
    max-width: 34rem;
  }

  .meta {
    max-width: none;
    margin: 1.5rem 0 4rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--meta-size);
    text-transform: var(--meta-transform);
    letter-spacing: var(--meta-tracking);
    color: var(--fg-muted);
  }

  .updated {
    max-width: none;
    margin-top: 3rem;
    font-family: var(--font-mono);
    font-size: var(--meta-size);
    letter-spacing: var(--meta-tracking);
    text-transform: var(--meta-transform);
    color: var(--fg-muted);
  }

  .back {
    max-width: none;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .back a {
    display: inline-block;
    border: 1px solid var(--accent);
    padding: 0.6rem 1.1rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--meta-size);
    letter-spacing: var(--meta-tracking);
    text-transform: var(--meta-transform);
  }

  .back a:hover {
    background: var(--accent);
    color: var(--ink);
  }
</style>
