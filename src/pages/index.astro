---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Astronaut from '../components/Astronaut.astro';
import { listPostsByLocale, translate } from '../i18n/utils';
import type { BlogPost } from '../i18n/utils';

const locale = 'es' as const;
const t = translate(locale);
const posts: BlogPost[] = await listPostsByLocale(locale);
---

<BaseLayout locale={locale} title={t.siteTitle} description={t.siteDescription} translationPath="">
  <section class="hero">
    <div class="astronaut-slot"><Astronaut /></div>
    <h1>{t.siteTitle}</h1>
    <p class="lede">{t.siteDescription}</p>
    <p class="scroll-cue">{t.scrollCue}</p>
  </section>

  <h2>{t.writingTitle}</h2>
  <PostList locale={locale} posts={posts} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: 1rem 5rem;
  }

  /* Decorative only, and it never sits under running text: the copy is stacked above it. */
  .astronaut-slot {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: 2%;
    width: min(17rem, 24vw);
    translate: 0 -50%;
    pointer-events: none;
  }

  .hero h1,
  .hero .lede,
  .hero .scroll-cue {
    position: relative;
    z-index: 1;
  }

  /* A stepped extrusion stands in for the reference's cast shadow, in plain CSS. */
  .hero h1 {
    font-size: clamp(2.5rem, 9vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
    padding-top: 0.12em;
    margin: 0 0 2rem;
    text-shadow:
      0.02em 0.02em 0 var(--rule),
      0.04em 0.04em 0 var(--rule),
      0.06em 0.06em 0 var(--rule),
      0.08em 0.08em 0 var(--rule),
      0.1em 0.1em 0 var(--rule),
      0.12em 0.12em 0 var(--rule),
      0.14em 0.14em 0 var(--rule),
      0.16em 0.16em 0 var(--rule),
      0.18em 0.18em 0 var(--rule),
      0.2em 0.2em 0 var(--rule);
  }

  .lede {
    max-width: var(--measure);
    font-size: 1.25rem;
    color: var(--fg-muted);
    margin: 0;
  }

  .scroll-cue {
    margin: 4rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--meta-size);
    letter-spacing: var(--meta-tracking);
    text-transform: var(--meta-transform);
    color: var(--fg-muted);
  }

  .scroll-cue::after {
    content: ' ↓';
    color: var(--signal);
  }

  /* Below this the hero has no free column, so the figure would cross the copy. */
  @media (max-width: 60rem) {
    .astronaut-slot {
      display: none;
    }
  }
</style>
