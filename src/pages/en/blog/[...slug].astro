---
import { render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { listPostRoutes } from '../../../i18n/utils';
import type { BlogPost, PostRoute } from '../../../i18n/utils';

export async function getStaticPaths(): Promise<PostRoute[]> {
  return listPostRoutes('en');
}

const { post } = Astro.props as { post: BlogPost };
const { Content } = await render(post);
---

<PostLayout post={post}>
  <Content />
</PostLayout>
