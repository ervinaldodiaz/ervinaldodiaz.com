---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Astronaut from '../../components/Astronaut.astro';
import PostList from '../../components/PostList.astro';
import { listPostsByLocale, translate } from '../../i18n/utils';
import type { BlogPost } from '../../i18n/utils';

const locale = 'es' as const;
const t = translate(locale);
const posts: BlogPost[] = await listPostsByLocale(locale);
---

<BaseLayout
  locale={locale}
  title={`${t.writingTitle} — ${t.siteTitle}`}
  description={t.writingIntro}
  translationPath="blog"
>
  <section class="page-head">
    <div class="astronaut-slot"><Astronaut /></div>
    <h1>{t.writingTitle}</h1>
    <p class="lede">{t.writingIntro}</p>
  </section>
  <PostList locale={locale} posts={posts} />
</BaseLayout>

<style>
  .page-head {
    position: relative;
  }

  .astronaut-slot {
    position: absolute;
    scale: -1 1;
    z-index: 0;
    top: 50%;
    right: 4%;
    width: min(9rem, 14vw);
    translate: 0 -50%;
    opacity: 0.75;
    pointer-events: none;
  }

  h1,
  .lede {
    position: relative;
    z-index: 1;
  }

  h1 {
    padding-top: 0.08em;
  }

  .lede {
    max-width: var(--measure);
    margin-bottom: 4rem;
    color: var(--fg-muted);
  }

  @media (max-width: 60rem) {
    .astronaut-slot {
      display: none;
    }
  }
</style>
