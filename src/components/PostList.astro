---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { formatPostDate, translate } from '../i18n/utils';
import type { BlogPost } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  posts: BlogPost[];
}

const { locale, posts } = Astro.props;
const t = translate(locale);
---

{
  posts.length === 0 ? (
    <p class="empty">{t.noPostsYet}</p>
  ) : (
    <ul class="post-list">
      {posts.map((post: BlogPost) => (
        <li>
          <a href={getRelativeLocaleUrl(locale, `blog/${post.id}`)}>{post.data.title}</a>
          <p class="excerpt">{post.data.description}</p>
          <p class="meta">
            <time datetime={post.data.date.toISOString()}>
              {formatPostDate(post.data.date, locale)}
            </time>
            {post.data.tags.length > 0 && <span class="tags">{post.data.tags.join(' · ')}</span>}
            {post.data.draft && <span class="draft">draft</span>}
          </p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: entry;
  }

  .post-list > li {
    counter-increment: entry;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--rule);
    transition: background-color 120ms ease-out;
  }

  .post-list > li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  /* The index number is ornament: the link text already names the post. */
  .post-list > li::before {
    content: counter(entry, decimal-leading-zero);
    grid-row: 1 / span 3;
    font-family: var(--font-mono);
    font-size: var(--meta-size);
    letter-spacing: var(--meta-tracking);
    color: var(--accent);
    padding-top: 0.6rem;
  }

  .post-list > li > a {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.8vw, 1.875rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg);
  }

  .post-list > li:hover > a {
    color: var(--accent);
  }

  .post-list > li:hover {
    background-color: var(--bg-lift);
  }

  .excerpt {
    margin: 0.75rem 0 1rem;
    max-width: var(--measure);
    color: var(--fg-muted);
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--meta-size);
    text-transform: var(--meta-transform);
    letter-spacing: var(--meta-tracking);
    color: var(--fg-muted);
  }

  .draft {
    background: var(--signal);
    color: var(--ink);
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    text-transform: uppercase;
  }

  .empty {
    color: var(--fg-muted);
  }

  @media (max-width: 34rem) {
    .post-list > li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .post-list > li::before {
      grid-row: auto;
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-list > li {
      transition: none;
    }
  }
</style>
