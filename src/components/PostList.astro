---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { formatPostDate, translate } from '../i18n/utils';
import type { BlogPost } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  posts: BlogPost[];
}

const { locale, posts } = Astro.props;
const t = translate(locale);
---

{
  posts.length === 0 ? (
    <p class="empty">{t.noPostsYet}</p>
  ) : (
    <ul class="post-list">
      {posts.map((post: BlogPost) => (
        <li>
          <a href={getRelativeLocaleUrl(locale, `blog/${post.id}`)}>{post.data.title}</a>
          <p class="excerpt">{post.data.description}</p>
          <p class="meta">
            <time datetime={post.data.date.toISOString()}>
              {formatPostDate(post.data.date, locale)}
            </time>
            {post.data.tags.length > 0 && <span class="tags">{post.data.tags.join(' · ')}</span>}
            {post.data.draft && <span class="draft">draft</span>}
          </p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .post-list li:last-child {
    border-bottom: none;
  }

  .post-list > li > a {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-decoration: none;
    color: var(--fg);
  }

  .post-list > li > a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .excerpt {
    margin: 0.5rem 0 0.75rem;
    color: var(--fg-muted);
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: var(--meta-transform);
    letter-spacing: var(--meta-tracking);
    color: var(--fg-muted);
  }

  .tags::before {
    content: '·';
    margin-right: 0.75rem;
  }

  .draft {
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
